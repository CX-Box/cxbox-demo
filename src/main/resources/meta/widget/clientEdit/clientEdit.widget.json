{
  "name": "clientEdit",
  "title": "General information",
  "type": "Form",
  "bc": "clientEdit",
  "fields": [
    {
      "label": "Client Name",
      "key": "fullName",
      "type": "suggestionPickList",
      "popupBcName": "companySuggestionPickList",
      "pickMap": {
        "fullName": "value",
        "address": "address"
      }
    },
    {
      "label": "Importance",
      "key": "importance",
      "type": "dictionary"
    },
    {
      "label": "Status",
      "key": "status",
      "type": "dictionary"
    },
    {
      "label": "Client code",
      "key": "clientCode",
      "type": "input"
    },
    {
      "label": "Field of Activity",
      "key": "fieldOfActivity",
      "type": "multipleSelect"
    },
    {
      "label": "Brief",
      "key": "brief",
      "type": "fileUpload",
      "fileIdKey": "briefId",
      "preview": {
        "enabled": true,
        "titleKey": "filePreviewTitle",
        "hintKey": "filePreviewHint",
        "mode": "popup",
        "miniPreview": true
      }
    }
  ],
  "options": {
    "layout": {
      "rows": [
        {
          "cols": [
            {
              "fieldKey": "fullName",
              "span": 12
            },
            {
              "fieldKey": "importance",
              "span": 12
            }
          ]
        },
        {
          "cols": [
            {
              "fieldKey": "status",
              "span": 12
            },
            {
              "fieldKey": "clientCode",
              "span": 12
            }
          ]
        },
        {
          "cols": [
            {
              "fieldKey": "fieldOfActivity",
              "span": 12
            },
            {
              "fieldKey": "brief",
              "span": 12
            }
          ]
        }
      ]
    },
    "extract": {
      "fields": {
        "importance": {
          "description": "ключевой заказчик = High, обычный = Middle"
        },
        "clientCode": {
          "pattern": "^[0-9]{6,12}$",
          "description": "внутренний код клиента или ИНН: только цифры"
        }
      }
    },
    "actionGroups": {
      "include": []
    }
  }
}
